{
  "name": "kipay",
  "version": "1.1.1",
  "description": "Official Node.js SDK for the KiPay QRIS payment gateway API (https://kipay.id/docs).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KiroFyzu/kipay-sdk.git"
  },
  "homepage": "https://github.com/KiroFyzu/kipay-sdk#readme",
  "bugs": {
    "url": "https://github.com/KiroFyzu/kipay-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "kipay",
    "qris",
    "payment-gateway",
    "payments",
    "indonesia"
  ],
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3"
  }
}
